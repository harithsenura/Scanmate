# Scanmate - Environment Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=true
APP_NAME="Scanmate AI Code Scanner"
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (Optional - for AI-powered fixes)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Llama-3 (Optional - alternative AI provider)
LLAMA_API_ENDPOINT=https://your-llama-endpoint.com/v1
LLAMA_API_KEY=your-llama-api-key

# Scanning Limits
MAX_FILE_SIZE_BYTES=5242880
MAX_SCAN_DURATION_SECONDS=120

# Real-time Updates
ENABLE_REALTIME_UPDATES=true
