APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase (Required)
SUPABASE_URL=https://exnvlnffaiavkqweduno.supabase.co
SUPABASE_KEY=sb_publishable__qjS3UyuwQbYowR0nxGi_A_QjnSdTpz
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (Optional - for AI-powered fixes)
OPENAI_API_KEY=sk-your-openai-api-key
